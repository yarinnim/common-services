{
  "name": "@common-services/socket-server",
  "version": "1.0.0",
  "main": "index.js",
  "author": "",
  "license": "ISC",
  "description": "",
  "scripts": {
    "build": "tsc --build -f ./tsconfig.json",
    "dev": "npm run build -- -w",
    "start:dev": "npm run build && nodemon src/index.ts",
    "start": "node build/index.js",

    "test": "jest --forceExit",
    "test:dev": "npm run test -- --watchAll",
    "eslint": "eslint src --ext .ts --ignore-pattern '**/*.test.ts' --ignore-pattern '**/*.spec.ts'",

    "migrate:make": "knex --knexfile ./knexfile.ts migrate:make -x ts ",
    "migrate:latest": "knex --knexfile ./knexfile.ts migrate:latest",
    "migrate:fresh": "knex --knexfile ./knexfile.ts migrate:rollback --all",
    "migrate:refresh": "npm run migrate:fresh && npm run migrate:latest && npm run seed:run",

    "seed:make": "knex --knexfile ./knexfile.ts seed:make",
    "seed:run": "knex --knexfile ./knexfile.ts seed:run"
  },

  "dependencies": {
    "xpref": "latest",
    "knexify": "latest",
    "@core/log-client": "^1.0.0",
    "@core/message-queue": "^1.0.0",
    "dotenv": "^16.4.5",
    "socket.io": "^4.8.1"
  }
}
